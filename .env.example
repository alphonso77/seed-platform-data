# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Stripe (must be a test key — sk_test_*)
STRIPE_SECRET_KEY=sk_test_your_key_here

# HubSpot (developer test portal access token)
HUBSPOT_ACCESS_TOKEN=your_hubspot_token_here

# Shopify (must be a development store)
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_token_here

# Email generation
DEFAULT_EMAIL_DOMAINS=fratellisoftware.com,testcompany.com

# Sandbox check overrides (development only — ignored in production)
# Set to true to skip sandbox/test environment verification for a platform.
# Useful during early development before provisioning sandbox accounts.
# SKIP_SANDBOX_CHECK_STRIPE=true
# SKIP_SANDBOX_CHECK_HUBSPOT=true
# SKIP_SANDBOX_CHECK_SHOPIFY=true
