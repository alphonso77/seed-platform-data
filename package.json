{
  "name": "seed-platform-data",
  "version": "1.0.0",
  "description": "CLI + web UI for seeding realistic test data into HubSpot, Stripe, and Shopify sandboxes",
  "main": "dist/server.js",
  "bin": {
    "seed-platform-data": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "cli": "tsx src/cli/index.ts",
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:all": "npm run build && concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "test": "mocha",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@faker-js/faker": "^9.6.0",
    "@hubspot/api-client": "^12.0.1",
    "@shopify/shopify-api": "^11.6.2",
    "@types/multer": "^2.1.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "inquirer": "^8.2.6",
    "libphonenumber-js": "^1.12.43",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "ora": "^5.4.1",
    "pg": "^8.23.1",
    "stripe": "^17.7.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/inquirer": "^8.2.10",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.23.1",
    "@types/sinon": "^17.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "chai": "^4.5.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-chai-friendly": "^1.1.1",
    "mocha": "^11.1.0",
    "sinon": "^19.0.2",
    "tsc-alias": "^1.8.11",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3"
  }
}
